generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Attendance {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    Int?      @default(1)
  timestamp DateTime? @default(now()) @db.Timestamp(6)
  method    String    @db.VarChar(50)
  pesertaId String    @db.Uuid
  qrTokenId String?   @db.Uuid
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  Peserta   Peserta   @relation(fields: [pesertaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_peserta")
  QRToken   QRToken?  @relation(fields: [qrTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_qr")

  @@index([pesertaId, timestamp], map: "idx_attendance_peserta_timestamp")
}

model Certificate {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateNumber String          @unique @db.VarChar(255)
  certificateType   CertificateType
  softFile          String
  issuedAt          DateTime        @db.Timestamp(6)
  eventId           String          @db.Uuid
  pesertaId         String          @db.Uuid
  createdAt         DateTime?       @default(now()) @db.Timestamp(6)
  updatedAt         DateTime?       @default(now()) @db.Timestamp(6)
  Event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_certificate_event")
  Peserta           Peserta         @relation(fields: [pesertaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_certificate_peserta")

  @@index([eventId], map: "idx_certificate_event")
  @@index([pesertaId], map: "idx_certificate_peserta")
  @@index([certificateType], map: "idx_certificate_type")
}

model Event {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(255)
  description String?
  startDate   DateTime      @db.Timestamp(6)
  endDate     DateTime      @db.Timestamp(6)
  location    String?       @db.VarChar(255)
  createdAt   DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime?     @default(now()) @db.Timestamp(6)
  Certificate Certificate[]
}

model Peserta {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  npm         String        @unique @db.VarChar(50)
  nama        String        @db.VarChar(255)
  email       String?       @db.VarChar(255)
  firstLogin  Boolean?      @default(true)
  userId      String        @unique @db.Uuid
  createdAt   DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime?     @default(now()) @db.Timestamp(6)
  Attendance  Attendance[]
  Certificate Certificate[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_peserta_user")
  Portfolio   Portfolio[]
}

model Portfolio {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(255)
  description String
  link        String?
  pesertaId   String    @db.Uuid
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @db.Timestamp(6)
  Peserta     Peserta   @relation(fields: [pesertaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_portfolio_peserta")

  @@index([pesertaId], map: "idx_portfolio_peserta")
}

model QRToken {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token        String       @unique
  isUsed       Boolean?     @default(false)
  expiresAt    DateTime     @db.Timestamp(6)
  sekretarisId String       @db.Uuid
  createdAt    DateTime?    @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?    @default(now()) @db.Timestamp(6)
  Attendance   Attendance[]
  Sekretaris   Sekretaris   @relation(fields: [sekretarisId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_qr_sekretaris")
}

model Rundown {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judul        String    @db.VarChar(255)
  deskripsi    String?
  waktuMulai   DateTime  @db.Timestamp(6)
  waktuSelesai DateTime  @db.Timestamp(6)
  isHighlight  Boolean?  @default(false)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)
}

model Sekretaris {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama      String    @db.VarChar(255)
  npm       String?   @unique @db.VarChar(50)
  userId    String    @unique @db.Uuid
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  QRToken   QRToken[]
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sekretaris_user")
}

model User {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username   String      @unique @db.VarChar(255)
  password   String
  role       Role
  createdAt  DateTime?   @default(now()) @db.Timestamp(6)
  updatedAt  DateTime?   @default(now()) @db.Timestamp(6)
  Peserta    Peserta?
  Sekretaris Sekretaris?
}

enum CertificateType {
  PESERTA
  KEJUARAAN
  PEMATERI
}

enum Role {
  SEKRETARIS
  PESERTA
}
